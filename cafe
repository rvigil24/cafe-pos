#!/usr/bin/env bash

set -Eeuo pipefail

readonly project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

show_help() {
  cat <<'EOF'
Usage: ./cafe <command>

Commands:
  pair       Pair and connect an Android phone over Wi-Fi
  devices    Show connected Android and Flutter devices
  check      Run formatting, analysis, and fast tests
  run        Build and launch Cafe POS on the connected device
  offline    Build and launch Cafe POS in airplane mode
  test       Run the complete validation suite on the connected device
  seed       Add missing dummy tables, categories, and products on the device
  reset      Erase all local Cafe POS data on the connected device
  help       Show this help
EOF
}

case "${1:-help}" in
  pair)
    exec "${project_root}/scripts/pair-phone.sh"
    ;;
  devices)
    "${project_root}/scripts/devices.sh"
    ;;
  check)
    exec "${project_root}/scripts/check.sh"
    ;;
  run)
    exec "${project_root}/scripts/run.sh"
    ;;
  offline)
    exec "${project_root}/scripts/run.sh" --offline
    ;;
  test)
    exec "${project_root}/scripts/test-all.sh"
    ;;
  seed)
    exec "${project_root}/scripts/seed.sh"
    ;;
  reset)
    exec "${project_root}/scripts/reset.sh" "${@:2}"
    ;;
  help|-h|--help)
    show_help
    ;;
  *)
    echo "Unknown command: $1" >&2
    show_help >&2
    exit 2
    ;;
esac
